{
  "name": "uplot",
  "version": "1.6.32",
  "description": "A small, fast chart for time series, lines, areas, ohlc & bars",
  "type": "module",
  "main": "./dist/uPlot.cjs.js",
  "module": "./dist/uPlot.esm.js",
  "typings": "./dist/uPlot.d.ts",
  "scripts": {
    "build": "rollup -c --bundleConfigAsCjs",
    "test": "NODE_OPTIONS='--import ./scripts2/register-hooks.mjs' nyc mocha",
    "test:update": "UPDATE=1 NODE_OPTIONS='--import ./scripts2/register-hooks.mjs' nyc mocha"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leeoniya/uPlot.git"
  },
  "files": [
    "package.json",
    "README.md",
    "LICENSE",
    "dist"
  ],
  "keywords": [
    "micro",
    "time",
    "series",
    "line",
    "area",
    "trend",
    "bar",
    "ohlc",
    "plot",
    "chart",
    "graph"
  ],
  "author": "Leon Sorokin <leeoniya@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/leeoniya/uPlot/issues"
  },
  "homepage": "https://github.com/leeoniya/uPlot#readme",
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.14.0",
    "@istanbuljs/esm-loader-hook": "^0.3.0",
    "@rollup/plugin-terser": "^1.0.0",
    "canvas": "^3.2.3",
    "happy-dom": "^20.14.0",
    "json-stringify-pretty-compact": "^4.0.0",
    "mocha": "^12.0.0",
    "nyc": "^18.0.0",
    "path2d": "^0.3.4",
    "rollup": "^4.63.1"
  },
  "nyc": {
    "include": [
      "dist/**/*.esm.js",
      "src/**/*.js"
    ],
    "exclude": [
      "src/paths/catmullRomCentrip.js"
    ]
  }
}
