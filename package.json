{
  "name": "uplot",
  "version": "1.6.32",
  "description": "A small, fast chart for time series, lines, areas, ohlc & bars",
  "keywords": [
    "area",
    "bar",
    "chart",
    "graph",
    "line",
    "micro",
    "ohlc",
    "plot",
    "series",
    "time",
    "trend"
  ],
  "homepage": "https://github.com/leeoniya/uPlot#readme",
  "bugs": {
    "url": "https://github.com/leeoniya/uPlot/issues"
  },
  "license": "MIT",
  "author": "Leon Sorokin <leeoniya@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leeoniya/uPlot.git"
  },
  "files": [
    "package.json",
    "README.md",
    "LICENSE",
    "dist"
  ],
  "type": "module",
  "main": "./dist/uPlot.cjs",
  "module": "./dist/uPlot.esm.js",
  "types": "./dist/uPlot.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/uPlot.d.ts",
        "default": "./dist/uPlot.esm.js"
      },
      "require": {
        "types": "./dist/uPlot.d.cts",
        "default": "./dist/uPlot.cjs"
      }
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "bench:legend": "node --max-old-space-size=96 ./scripts/bench-legend.mjs",
    "demos": "node ./scripts/demos.mjs",
    "test": "vp test run --project unit --coverage",
    "test:server": "vp test run --project server",
    "test:update": "UPDATE=1 vp test run --project unit"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.14.5",
    "@vitest/coverage-istanbul": "^5.0.3",
    "happy-dom": "^20.14.5",
    "json-stringify-pretty-compact": "^4.0.0",
    "vite-plus": "1.1.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0"
  }
}
